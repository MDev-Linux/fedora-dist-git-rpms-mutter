Subject: [PATCH 07/19] window-drag: Don't get frame rect twice when updating
 move

---
 src/compositor/meta-window-drag.c | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/src/compositor/meta-window-drag.c b/src/compositor/meta-window-drag.c
index dc79cb3cc8..c86914753f 100644
--- a/src/compositor/meta-window-drag.c
+++ b/src/compositor/meta-window-drag.c
@@ -1200,7 +1200,7 @@ update_move (MetaWindowDrag          *window_drag,
   MetaWindow *window;
   int dx, dy;
   int new_x, new_y;
-  MtkRectangle old, frame_rect;
+  MtkRectangle frame_rect;
   int shake_threshold;
 

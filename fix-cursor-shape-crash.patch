From 9f1d8fec3237133cea311433d0371cbbb7c43ee5 Mon Sep 17 00:00:00 2001
From: Sebastian Wick <sebastian.wick@redhat.com>
Date: Fri, 28 Feb 2025 17:35:17 +0100
Subject: [PATCH 03/12] cursor-renderer/native: Log instead of warn when cursor
 size mismatch

KMS can support only very specific cursor sizes and having a cursor that
doesn't match that size isn't something going wrong. Instead of
generating a warning, just log it.
---
 src/backends/native/meta-cursor-renderer-native.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/backends/native/meta-cursor-renderer-native.c b/src/backends/native/meta-cursor-renderer-native.c
index 573143df3b..85dd92c5c2 100644
--- a/src/backends/native/meta-cursor-renderer-native.c
+++ b/src/backends/native/meta-cursor-renderer-native.c
@@ -1159,8 +1159,9 @@ realize_cursor_sprite_from_wl_buffer_for_crtc (MetaCursorRenderer      *renderer
 
       if (!supports_exact_cursor_size (crtc_kms, width, height))
         {
-          g_warning ("Invalid cursor size %ux%u, falling back to SW GL cursors)",
-                     width, height);
+          meta_topic (META_DEBUG_BACKEND,
+                      "Invalid cursor size %ux%u, falling back to SW GL cursors)",
+                      width, height);
           return FALSE;
         }
 
-- 
